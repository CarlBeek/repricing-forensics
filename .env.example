# Producer DB: where reth-research writes the new schema (see
# docs/storage-redesign.md). Falls back to ./synthetic.duckdb so a fresh
# checkout can be demoed via scripts/build_synthetic_producer_db.py.
# PRODUCER_DB_PATH=~/reth/research.duckdb

# Schedule name to surface in the dashboard. Producer rows carry this as
# a column; the consumer's views filter by it.
# SCHEDULE_NAME=eip-8037

# Consumer-owned dirs.
# CACHE_DIR=./cache         # contract_labels.csv
# ARTIFACTS_DIR=./artifacts # optional CSVs (failure motifs, remediation)

# Ethereum API keys (used by ad-hoc scripts; the live web app doesn't
# need them).
# ETHERSCAN_API_KEY=

# DuckDB tuning
# DUCKDB_THREADS=16
