# Producer DB: where reth-research writes the SQLite source of truth
# (see docs/storage-redesign.md). Falls back to ./synthetic.sqlite so a
# fresh checkout can be demoed via scripts/build_synthetic_producer_db.py.
# PRODUCER_DB_PATH=~/reth/divergences.sqlite

# Schedule name to surface in the dashboard. Producer rows carry this as
# a column; the consumer's views filter by it.
# SCHEDULE_NAME=eip-8037

# Consumer-owned dir. Holds an optional contract_labels.csv that adds to
# the hardcoded address-label map in src/repricing_forensics/labels.py.
# CACHE_DIR=./cache

# Ethereum API keys (used by ad-hoc scripts; the live web app doesn't
# need them).
# ETHERSCAN_API_KEY=

# DuckDB tuning
# DUCKDB_THREADS=16
